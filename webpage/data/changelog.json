    {
      "date": "2026-10-17",
      "title": "每周视频与个人阅读周报，网站和 App 一起回看",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "新增「每周视频」，无需登录即可观看。首期「从养老收费，到中国制造的新变化」约 4 分 54 秒，附章节跳转、中文字幕文件、延伸文章和事实来源。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "新增「我的周报」，登录后可按北京时间查看每周阅读文章、经典章节、阅读时长和问问、阿烬的提问记录，支持切换日期与回看往周。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "个人周报支持导出完整长图，保存这一周的阅读与追问。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "App 个人页新增更新日志入口，与网站共用一份记录，可按网站、App、后端与 AI 筛选。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "文章和经典阅读器开始记录登录后的有效阅读时长，切到后台或长时间没有操作时暂停计时；新增记录用于周报，旧记录不补算阅读时长。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "每日文章暂时使用本地备用内容后，会继续尝试生成当天文章；重试失败时保留已有内容，避免今日清单被清空。",
              "types": [
                "ai"
              ]
            },
            {
              "text": "网站导航加入「每周视频」和「我的周报」，App 底部新增「每周」，集中查看节目与个人周报。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        }
      ]
    },
