    {
      "date": "2026-09-26",
      "title": "每日文章改用官方来源，AI 不可用时也能回答",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "每日 5 篇文章改为从中国政府网的最新新闻和政策出发生成；每篇必须写明成本或风险，只引用给定来源。",
              "types": [
                "ai"
              ]
            },
            {
              "text": "问问的对话会保存在本机，离开再回来还能接着看。",
              "types": [
                "app"
              ]
            },
            {
              "text": "App 换上新图标，网页图标和问问图标同步更新。",
              "types": [
                "app"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "文章生成后会检查篇数、段落长度、来源和空话套话，不合格先重试一次，再不行就改用本地文章。",
              "types": [
                "ai"
              ]
            },
            {
              "text": "外部 AI 暂时不可用时，问问会根据站内内容回答，阿烬也会给出本地回复，不再直接报错。",
              "types": [
                "ai"
              ]
            }
          ]
        }
      ]
