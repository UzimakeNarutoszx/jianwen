{
  "entries": [
    {
      "date": "2026-11-10",
      "title": "今日朗读支持后台播放，1.1.4 整包上线",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "今日朗读支持后台播放：锁屏、切到其他应用时继续出声，系统播放器显示篇目标题和声音。",
              "types": [
                "app"
              ]
            },
            {
              "text": "拙政观景首页大图改为预加载，首屏图片更早开始下载。",
              "types": [
                "web"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "播放器换篇、换声音时沿用当前进度续播；页面切到后台不再强制停止朗读。",
              "types": [
                "app"
              ]
            },
            {
              "text": "同步更新 1.1.4 安装包与下载页版本信息。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        }
      ]
    },
    {
      "date": "2026-11-09",
      "title": "每日朗读改到服务器自动生成，Android 资源补丁上线",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "今日朗读不再依赖电脑：每天 06:20 起在服务器自动生成当天 5 篇、两种声音的音频，07:00 / 08:00 / 09:00 还会自动重试。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "Android 端收到 1.1.3 资源补丁（约 1 MB），安装后自动重启生效，不需要重新下载完整安装包。",
              "types": [
                "app"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "朗读声音更新为「见闻」与「男声」，声音名称与音频内容保持一致。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "下载页、版本清单与安装包统一到 1.1.2，修复三处版本号不一致。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        }
      ]
    },
    {
      "date": "2026-11-08",
      "title": "今日朗读上线，App 内更新修好，安装包更小",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "今日朗读：每天 5 篇文章自动合成两种声音的音频，网站和 App 都能直接听；听完一篇就等同读完，记进今日已读和阅读历史。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "App 个人页新增「检查更新」，可以手动查有没有新版本。",
              "types": [
                "app"
              ]
            },
            {
              "text": "每周视频更新到第 4 期「从公开展示，到 Android 1.0.2」。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "朗读播放器重新排版：标题按中文标点整段换行，不再把一个词劈成两行；声音改成下拉选择，只列这一篇确实有音频的声音；播放进度和总时长分列两端。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "朗读前先把阿拉伯数字改写成中文读法，合成后再用语音识别回听比对，读错就换随机种子重读，最多 3 次，仍不合格的篇目当天不发布这个声音。",
              "types": [
                "ai"
              ]
            },
            {
              "text": "App 安装包从 24.4 MB 减到 19.2 MB，移出了源码里从未引用的 5.2 MB 宣传片素材。",
              "types": [
                "app"
              ]
            },
            {
              "text": "应用内更新下载时显示百分比进度，不再是一个静止的「正在下载」。",
              "types": [
                "app"
              ]
            },
            {
              "text": "修复一个存在了几个版本的更新问题：应用内更新缺少安装权限，安装包下载完成后无法唤起系统安装器，用户只看到「什么都没发生」。",
              "types": [
                "app"
              ]
            },
            {
              "text": "资源包热更新正在完善中，暂时通过完整安装包更新。",
              "types": [
                "app"
              ]
            },
            {
              "text": "分类封面改为只由服务器提供，不再打进安装包，安装包更小，资源包也能正常导出。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        }
      ]
    },
    {
      "date": "2026-10-31",
      "title": "发现页重做，问问更顺，每周视频补上两期",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "首页新增大事报道：党代会、中央全会、人代会、政协会议经官方确认后置顶显示，闭幕后标注「已闭幕」并保留 7 天。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "网站新增分类页：点发现页的主题或专题卡片，会进入该主题的文章列表。",
              "types": [
                "web"
              ]
            },
            {
              "text": "每日文章按九个频道归类，频道里能看到每天的新文章。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "网站发现页「最近更新」加配图，按本周、本月、更早分组，标出日期。",
              "types": [
                "web"
              ]
            },
            {
              "text": "每周视频补上第 2、3 期，每期约 1 分钟。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "App 问问的回答下方加复制按钮。",
              "types": [
                "app"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "问问回答改成匀速逐字出现，长回答后半段不再成块跳出，网站和 App 节奏一致。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "修复问问有时停在「正在思考」不出回答的问题。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "App 问问进入后停在最新一条，只显示最近 7 轮，更早的在「问问记录」里。",
              "types": [
                "app"
              ]
            },
            {
              "text": "App 问问右侧导航条：点击区加大，高亮跟随滚动，不再同时亮两条。",
              "types": [
                "app"
              ]
            },
            {
              "text": "从发现页或分类页打开文章，返回按钮回到原来的页面。",
              "types": [
                "web"
              ]
            },
            {
              "text": "暗色模式下问问回答的文字对比度修正；网页输入框聚焦样式统一。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "登录失效时自动回到登录页，登录后返回原页面。",
              "types": [
                "app"
              ]
            },
            {
              "text": "分类图片压缩，App 安装包和网页加载更快。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "AI 每日提问额度改为独立计数，删除问问记录不影响额度；登录加防暴力尝试保护。",
              "types": [
                "ai"
              ]
            }
          ]
        }
      ]
    },
    {
      "date": "2026-10-17",
      "title": "每周视频与个人阅读周报，网站和 App 一起回看",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "新增「每周视频」，无需登录即可观看。首期「从养老收费，到中国制造的新变化」约 4 分 54 秒，附章节跳转、中文字幕文件、延伸文章和事实来源。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "新增「我的周报」，登录后可按北京时间查看每周阅读文章、经典章节、阅读时长和问问、阿烬的提问记录，支持切换日期与回看往周。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "个人周报支持导出完整长图，保存这一周的阅读与追问。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "App 个人页新增更新日志入口，与网站共用一份记录，可按网站、App、后端与 AI 筛选。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "文章和经典阅读器开始记录登录后的有效阅读时长，切到后台或长时间没有操作时暂停计时；新增记录用于周报，旧记录不补算阅读时长。",
              "types": [
                "web",
                "app"
              ]
            },
            {
              "text": "每日文章暂时使用本地备用内容后，会继续尝试生成当天文章；重试失败时保留已有内容，避免今日清单被清空。",
              "types": [
                "ai"
              ]
            },
            {
              "text": "网站导航加入「每周视频」和「我的周报」，App 底部新增「每周」，集中查看节目与个人周报。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        }
      ]
    },
    {
      "date": "2026-10-11",
      "title": "宣传片上线，三处问题修复",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "首页和更新日志页加入 30 秒见闻宣传片，可点播，带旁白。",
              "types": [
                "web"
              ]
            },
            {
              "text": "新增「更新日志」页面，导航和页脚都能进入。",
              "types": [
                "web"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "App 里分类、搜索、收藏、最近看过、问问记录这几个页面，打开时不再报错。",
              "types": [
                "app"
              ]
            },
            {
              "text": "首页分区导航在手机上不再左右多出一截。",
              "types": [
                "web"
              ]
            },
            {
              "text": "没有指定书目时打开经典阅读器，会提示无法打开，不再把整个书单当成一本书显示。",
              "types": [
                "app"
              ]
            }
          ]
        }
      ]
    },
    {
      "date": "2026-10-02",
      "title": "Beta 版：导航更精简，发现页整合搜索和经典",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "发现页并入搜索和经典阅读：「先搜一个问题」「回到思想的源头」两个区块。",
              "types": [
                "web"
              ]
            },
            {
              "text": "阿烬的介绍、能力、成长和对话合成一页，带分区导航，可以直接在页面里和阿烬对话。",
              "types": [
                "web"
              ]
            },
            {
              "text": "首页新增分区导航和滚动进度条。",
              "types": [
                "web"
              ]
            },
            {
              "text": "网站和 App 会连接当前打开页面的主机，同一网络下用手机也能访问。",
              "types": [
                "web",
                "app"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "全站导航精简为首页、今日、发现、AI 问问、阿烬几项。",
              "types": [
                "web"
              ]
            },
            {
              "text": "还停留在旧版本的窗口会自动刷新到新版，更新能马上看到。",
              "types": [
                "web"
              ]
            },
            {
              "text": "发现页在手机上改为单栏排列，搜索、结果和经典卡片不再挤在一起。",
              "types": [
                "web"
              ]
            },
            {
              "text": "修复 AI 问问和阿烬在新运行环境下连接失败的问题。",
              "types": [
                "ai"
              ]
            },
            {
              "text": "文章配图的地址与 App 统一，图片能正常显示。",
              "types": [
                "ai"
              ]
            }
          ]
        }
      ]
    },
    {
      "date": "2026-09-26",
      "title": "每日文章改用官方来源，AI 不可用时也能回答",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "每日 5 篇文章改为从中国政府网的最新新闻和政策出发生成；每篇必须写明成本或风险，只引用给定来源。",
              "types": [
                "ai"
              ]
            },
            {
              "text": "问问的对话会保存在本机，离开再回来还能接着看。",
              "types": [
                "app"
              ]
            },
            {
              "text": "App 换上新图标，网页图标和问问图标同步更新。",
              "types": [
                "app"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "文章生成后会检查篇数、段落长度、来源和空话套话，不合格先重试一次，再不行就改用本地文章。",
              "types": [
                "ai"
              ]
            },
            {
              "text": "外部 AI 暂时不可用时，问问会根据站内内容回答，阿烬也会给出本地回复，不再直接报错。",
              "types": [
                "ai"
              ]
            }
          ]
        }
      ]
    },
    {
      "date": "2026-09-19",
      "title": "横屏网站首版",
      "groups": [
        {
          "title": "新功能",
          "items": [
            {
              "text": "门户首页改为横屏双栏布局，全站统一视觉。",
              "types": [
                "web"
              ]
            },
            {
              "text": "经典阅读器：书架可搜索，支持目录搜索、上下章、字号、专注模式和每本书的阅读进度；登录后进度存进账号。",
              "types": [
                "web"
              ]
            },
            {
              "text": "AI 问问流式回答，支持停止、重试和复制，回答里的格式安全显示。",
              "types": [
                "web"
              ]
            },
            {
              "text": "文章页显示相关推荐；个人页可以修改昵称、简介和关注主题。",
              "types": [
                "web"
              ]
            },
            {
              "text": "「播放序幕」开场页，可重播，按 Esc 退出。",
              "types": [
                "web"
              ]
            }
          ]
        },
        {
          "title": "改进与修复",
          "items": [
            {
              "text": "支持跳过导航、清晰的键盘焦点和减少动态效果。",
              "types": [
                "web"
              ]
            },
            {
              "text": "修复关注主题重复时报错、收藏和历史标题为空、搜索里的特殊符号被误当成通配符等问题。",
              "types": [
                "web"
              ]
            },
            {
              "text": "修复头像上传和登录过期的边界情况，以及旧脚本缓存导致更新不显示。",
              "types": [
                "web"
              ]
            }
          ]
        }
      ]
    }
  ]
}
